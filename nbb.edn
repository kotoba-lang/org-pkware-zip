;; nbb has no dependency resolver, so org-ietf-deflate comes from the sibling
;; checkout — which is exactly how west lays this workspace out
;; (orgs/kotoba-lang/org-ietf-deflate next to orgs/kotoba-lang/org-pkware-zip).
;; CI clones the pinned sha to the same relative path.
{:deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}}
 :paths ["src" "test" "../org-ietf-deflate/src" "../org-sourceware-bzip2/src"]}
